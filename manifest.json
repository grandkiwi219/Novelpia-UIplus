{
    "manifest_version": 3,
    "name": "노벨피아 UI+",
    "description": "더 나은 노벨피아 UI를 경험해보세요!",
    "author": "grand-kiwi",
    "version": "3.1.2.0",
    "browser_specific_settings": {
        "gecko": {
            "id": "",
            "strict_min_version": "117.0"
        }
    },
    "content_scripts": [
        {
            "tag": "모두",
            "matches": ["*://*.novelpia.com/*"],
            "exclude_matches": [
                "*://images.novelpia.com/*",
                "*://image.novelpia.com/*",
                
                "*://novelpia.com/img/*",
                "*://novelpia.com/css/*",
                "*://novelpia.com/js/*",
                "*://novelpia.com/lib/*"
            ],
            "js": [
                "./src/npup.js",
                "./src/setup.js",
                "./src/content.js"
            ],
            "css": [
                "./src/css/setup-content.css",
                "./src/css/system-content.css",
                "./src/css/mobile-content.css"
            ],
            "run_at": "document_start"
        },

        
        {
            "tag": "기본 웹소설 페이지 옵션",
            "matches": ["*://novelpia.com/*"],
            "exclude_matches": [
                "*://novelpia.com/img/*",
                "*://novelpia.com/css/*",
                "*://novelpia.com/js/*",
                "*://novelpia.com/lib/*"
            ],
            "js": [
                "./src/base/settings.js",

                "./src/base/system-part/system/header.js",
                "./src/base/system-part/system/navigation.js",
                "./src/base/system-part/system/navigation.js",
                "./src/base/system-part/system/novel.js",
                "./src/base/system-part/system/mobile.js",
                "./src/base/system-part/system/other.js",
                "./src/base/system-part/system/viewer.js",
                "./src/base/system-part/system/keyMapping.js",

                "./src/base/system-part/custom/custom-css.js",

                "./src/base/system-part/pre-common/other.js",
                "./src/base/system-part/pre-common/experimental.js"
            ],
            "run_at": "document_start"
        },




        
        {
            "tag": "페이지 엔진 | 기본 웹소설 페이지에서 뷰어들을 제외한 모두",
            "matches": ["*://novelpia.com/*"],
            "exclude_matches": [
                "*://novelpia.com/viewer/*",
                "*://novelpia.com/viewer_collect/*",
                "*://novelpia.com/comic_viewer/*",
                "*://novelpia.com/page/block/*",

                "*://novelpia.com/img/*",
                "*://novelpia.com/css/*",
                "*://novelpia.com/js/*",
                "*://novelpia.com/lib/*"
            ],
            "js": [
                "./src/base/engine/page.js"
            ],
            "run_at": "document_start"
        },
        {
            "tag": "뷰어 엔진 | 기본 웹소설 페이지에서 기본 뷰어",
            "matches": ["*://novelpia.com/viewer/*"],
            "js": [
                "./src/base/engine/viewer.js"
            ],
            "run_at": "document_start"
        },





        {
            "tag": "옵션 스크립트 바인딩",
            "matches": ["*://*.novelpia.com/*"],
            "exclude_matches": [
                "*://images.novelpia.com/*",
                "*://image.novelpia.com/*",
                
                "*://novelpia.com/img/*",
                "*://novelpia.com/css/*",
                "*://novelpia.com/js/*",
                "*://novelpia.com/lib/*"
            ],
            "js": [
                "./src/options-setup.js"
                
            ],
            "css": [
                "./src/css/setup-content.css",
                "./src/css/system-content.css",
                "./src/css/mobile-content.css"
            ],
            "run_at": "document_start"
        },





        {
            "tag": "기본 웹소설 페이지에서 기본 검색 페이지",
            "matches": ["*://novelpia.com/search/*"],
            "js": ["./src/base/part/dynamic-search.js"],
            "run_at": "document_end"
        }
    ],
    "background": {
        "service_worker": "./service/background.js"
    },
    "options_ui": {
        "page": "./page/options.html",
        "open_in_tab": true
    },
    "permissions": [
        "storage"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "src/*"
            ],
            "matches": ["*://*.novelpia.com/*"]
        }
    ],
    "action": {
        "default_icon": {
            "16": "/img/icon.png",
            "32": "/img/icon.png",
            "48": "/img/icon.png",
            "128": "/img/icon.png"
        }
    },
    "icons": {
            "16": "/img/icon.png",
            "32": "/img/icon.png",
            "48": "/img/icon.png",
            "128": "/img/icon.png"
    },
    "commands": {
        "run-options": {
            "description": "옵션 설정 페이지 열기"
        }
    }
}