{
    "manifest_version": 3,
    "name": "노벨피아 UI+",
    "description": "더 나은 노벨피아 UI를 경험해보세요!",
    "author": "grand-kiwi",
    "version": "3.9.2.1",
    "browser_specific_settings": {
        "gecko": {
            "id": "",
            "strict_min_version": "117.0"
        }
    },
    "content_scripts": [
        {
            "tag": "CSS",
            "matches": ["*://*.novelpia.com/*"],
            "css": [
                "./src/css/setup-content.css",
                "./src/css/system-content.css",
                "./src/css/mobile-content.css",
                "./src/css/books-content.css",
                "./src/css/webtoon-content.css"
            ],
            "run_at": "document_start"
        },
        {
            "tag": "모두",
            "matches": ["*://*.novelpia.com/*"],
            "exclude_matches": [
                "*://images.novelpia.com/*",
                "*://image.novelpia.com/*"
            ],
            "js": [
                "./src/npup.js",
                "./src/setup.js",
                "./src/assets.js",
                "./src/structure.js",
                "./src/content.js",
                "./src/options-category.js",
                "./src/route-detector.js"
            ],
            "run_at": "document_start"
        },
        {
            "tag": "document-status",
            "matches": ["*://*.novelpia.com/*"],
            "exclude_matches": [
                "*://images.novelpia.com/*",
                "*://image.novelpia.com/*"
            ],
            "js": [
                "./src/etc/document-status.js"
            ],
            "run_at": "document_end"
        },
        {
            "tag": "document-status",
            "matches": ["*://*.novelpia.com/*"],
            "exclude_matches": [
                "*://images.novelpia.com/*",
                "*://image.novelpia.com/*"
            ],
            "js": [
                "./src/etc/document-status.js"
            ],
            "run_at": "document_idle"
        },

        



        {
            "tag": "기본 노벨피아",
            "matches": ["*://novelpia.com/*"],
            "js": [
                "./src/base/engine.js"
            ],
            "run_at": "document_start"
        },
        {
            "matches": ["*://novelpia.com/*"],
            "exclude_matches": [
                "*://novelpia.com/img/*",
                "*://novelpia.com/css/*",
                "*://novelpia.com/js/*",
                "*://novelpia.com/lib/*",
                "*://novelpia.com/proc/*",
                "*://novelpia.com/json/*",
                "*://novelpia.com/api/*",
                "*://novelpia.com/error/*" ,
                "*://novelpia.com/manifest.json" ,
                "*://novelpia.com/robots.txt"
            ],
            "js": [
                "./src/base/settings.js",
                "./src/base/assets.js",

                "./src/base/system-part/system/header.js",
                "./src/base/system-part/system/navigation.js",
                "./src/base/system-part/system/novel.js",
                "./src/base/system-part/system/mobile.js",
                "./src/base/system-part/system/other.js",
                "./src/base/system-part/system/viewer.js",
                
                "./src/base/system-part/common/key-mapping.js",
                
                "./src/base/system-part/custom/custom-css.js",

                "./src/base/system-part/pre-common/other.js",
                "./src/base/system-part/pre-common/experimental.js"
            ],
            "run_at": "document_start"
        },

        



        {
            "tag": "북스 노벨피아",
            "matches": ["*://book.novelpia.com/*"],
            "js": [
                "./src/books/engine.js"
            ],
            "run_at": "document_start"
        },
        {
            "matches": ["*://book.novelpia.com/*"],
            "exclude_matches": [
                "*://book.novelpia.com/_nuxt/*",
                "*://book.novelpia.com/scripts/*",
                "*://book.novelpia.com/robots.txt"
            ],
            "js": [
                "./src/books/settings.js",

                "./src/books/system-part/common/key-mapping.js",
                
                "./src/books/system-part/custom/custom-css.js",

                "./src/books/system-part/pre-common/other.js"
            ],
            "run_at": "document_start"
        },





        {
            "tag": "웹툰 노벨피아",
            "matches": ["*://toptoon.novelpia.com/*"],
            "js": [
                "./src/webtoon/engine.js"
            ],
            "run_at": "document_start"
        },
        {
            "matches": ["*://toptoon.novelpia.com/*"],
            "exclude_matches": [
                "*://toptoon.novelpia.com/_nuxt/*",
                "*://toptoon.novelpia.com/scripts/*",
                "*://toptoon.novelpia.com/robots.txt"
            ],
            "js": [
                "./src/webtoon/settings.js",

                "./src/webtoon/system-part/common/key-mapping.js",
                
                "./src/webtoon/system-part/custom/custom-css.js"
            ],
            "run_at": "document_start"
        },





        {
            "tag": "옵션 스크립트 바인딩",
            "matches": ["*://*.novelpia.com/*"],
            "exclude_matches": [
                "*://images.novelpia.com/*",
                "*://image.novelpia.com/*"
            ],
            "js": [
                "./src/key-binding.js",
                "./src/options-setup.js"
                
            ],
            "run_at": "document_start"
        }
    ],
    "background": {
        "service_worker": "./service/background.js"
    },
    "options_ui": {
        "page": "./page/options.html",
        "open_in_tab": true
    },
    "permissions": [
        "storage"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "src/*"
            ],
            "matches": ["*://*.novelpia.com/*"]
        }
    ],
    "action": {
        "default_icon": {
            "16": "/img/icon.png",
            "32": "/img/icon.png",
            "48": "/img/icon.png",
            "128": "/img/icon.png"
        }
    },
    "icons": {
            "16": "/img/icon.png",
            "32": "/img/icon.png",
            "48": "/img/icon.png",
            "128": "/img/icon.png"
    },
    "commands": {
        "run-options": {
            "description": "옵션 설정 페이지 열기"
        }
    }
}